{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🪟 Windows Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.buildDirectory}",
            "preLaunchTask": "CMake: build",
            "internalConsoleOptions": "openOnSessionStart",
            "console": "internalConsole",
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis",
            "environment": [
                {
                    "name": "Path",
                    "value": "${env:Path};${workspaceFolder}\\..\\aqt\\6.10.2\\msvc2022_64\\bin\\;${workspaceFolder}\\..\\aqt\\6.10.2\\msvc2022_64\\plugins\\;${workspaceFolder}\\..\\aqt\\6.10.2\\msvc2022_64\\qml\\;${workspaceFolder}\\..\\vcpkg\\installed\\x64-windows\\debug\\bin;"
                }
            ],
            "logging": {
                "moduleLoad": false,
                "trace": true
            },
            "sourceFileMap": {
                "C:/Users/qt/work/qt": "${workspaceFolder}/../aqt/6.10.2/Src"
            }
        },
        {
            "name": "🐧linux Launch",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.buildDirectory}/bin",
            "env": {
                "LD_LIBRARY_PATH": "${workspaceFolder}/../aqt/6.10.2/gcc_64/lib:${workspaceFolder}/../aqt/6.10.2/gcc_64/plugins:${command:cmake.buildDirectory}/ThirdParty/qqcoro/lib:${command:cmake.buildDirectory}/ThirdParty/QArchive:${command:cmake.buildDirectory}/lib:${env:LD_LIBRARY_PATH}",
                "Path": "${env:Path};${workspaceFolder}/../aqt/6.10.2/gcc_64/bin/;${workspaceFolder}/../aqt/6.10.2/gcc_64/lib/;${workspaceFolder}/../aqt/6.10.2/gcc_64/modules/;${workspaceFolder}/../aqt/6.10.2/gcc_64/qml/;${workspaceFolder}/../vcpkg/installed/x64-linux/debug/lib;"
            },
            "sourceFileMap": {
                "/home/qt/work/qt": "${workspaceFolder}/../aqt/6.10.2/Src"
            }
        },
        {
            "name": "🎮 Godot Wallpaper",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/ThirdParty/Godot/Godot_v4.5.1-stable_linux.x86_64",
            "args": [
                "--path",
                "${workspaceFolder}/ScreenPlayWallpaper/Godot/ScreenPlayGodot",
                "--",
                "--projectpath",
                "${workspaceFolder}/Content/wallpaper_godot/",
                "--appID",
                "test",
                "--screens",
                "{0}",
                "--volume",
                "1",
                "--check",
                "0",
                "--projectPackageFile",
                "project-v1.zip",
                "--fps",
                "60"
            ],
            "cwd": "${workspaceFolder}/ScreenPlayWallpaper/Godot/ScreenPlayGodot",
            "windows": {
                "program": "${workspaceFolder}/ThirdParty/Godot/Godot_v4.5.1-stable_win64.exe"
            },
            "osx": {
                "program": "${workspaceFolder}/ThirdParty/Godot/Godot.app/Contents/MacOS/Godot"
            }
        },
        {
            "name": "🍏macOS",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.buildDirectory}",
            "env": {
                "DYLD_FRAMEWORK_PATH": "${workspaceFolder}/../aqt/6.10.2/macos/lib:${workspaceFolder}/../aqt/6.10.2/macos/plugins",
                "DYLD_LIBRARY_PATH": "${workspaceFolder}/../aqt/6.10.2/macos/lib:${workspaceFolder}/../aqt/6.10.2/macos/plugins",
                "QML2_IMPORT_PATH": "${workspaceFolder}/../aqt/6.10.2/macos/qml",
                "Path": "${env:Path}:${workspaceFolder}/../aqt/6.10.2/macos/bin:${workspaceFolder}/../aqt/6.10.2/macos/lib:${workspaceFolder}/../aqt/6.10.2/macos/qml"
            },
            "sourceFileMap": {
                "/Users/qt/work/qt": "${workspaceFolder}/../aqt/6.10.2/Src"
            }
        },
        {
            "name": "🐍 Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}