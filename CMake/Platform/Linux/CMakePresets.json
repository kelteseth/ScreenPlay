{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "include": [
        "../Common/CMakePresets.json",
        "../Common/DeployPresets.json"
    ],
    "configurePresets": [
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": [
                "default",
                "ninja",
                "host-linux"
            ],
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/../aqt/6.11.1/gcc_64",
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "linux-gcc-base",
            "hidden": true,
            "description": "Use gold linker to fix linking",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=gold",
                "CMAKE_CXX_FLAGS": "-fuse-ld=gold"
            }
        },
        {
            "name": "linux-gcc-debug",
            "binaryDir": "${sourceDir}/Build/Gcc_Debug",
            "inherits": [
                "debug",
                "config-develop",
                "linux-gcc-base"
            ]
        },
        {
            "name": "linux-gcc-relwithdebinfo",
            "binaryDir": "${sourceDir}/Build/Gcc_RelWithDebInfo",
            "inherits": [
                "relwithdebinfo",
                "config-develop",
                "linux-gcc-base"
            ]
        },
        {
            "name": "linux-gcc-release",
            "binaryDir": "${sourceDir}/Build/Gcc_Release",
            "cacheVariables": {
                "CMAKE_BINARY_DIR": "${sourceDir}/Build/Gcc_Release"
            },
            "inherits": [
                "release",
                "config-develop",
                "linux-gcc-base"
            ]
        },
        {
            "name": "linux-clang-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "linux-clang-debug",
            "binaryDir": "${sourceDir}/Build/Clang_Debug",
            "inherits": [
                "debug",
                "config-develop",
                "linux-clang-base"
            ]
        },
        {
            "name": "linux-clang-relwithdebinfo",
            "binaryDir": "${sourceDir}/Build/Clang_RelWithDebInfo",
            "inherits": [
                "relwithdebinfo",
                "config-develop",
                "linux-clang-base"
            ]
        },
        {
            "name": "linux-clang-release",
            "binaryDir": "${sourceDir}/Build/Clang_Release",
            "cacheVariables": {
                "CMAKE_BINARY_DIR": "${sourceDir}/Build/Clang_Release"
            },
            "inherits": [
                "release",
                "config-develop",
                "linux-clang-base"
            ]
        },
        {
            "name": "linux-deploy-release",
            "inherits": [
                "linux-gcc-release",
                "deploy-base"
            ],
            "displayName": "Deploy Release (linux)",
            "description": "Deploy Release build with QML dependencies"
        }
    ],
    "buildPresets": [
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug"
        },
        {
            "name": "linux-gcc-relwithdebinfo",
            "configurePreset": "linux-gcc-relwithdebinfo"
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release"
        },
        {
            "name": "linux-clang-debug",
            "configurePreset": "linux-clang-debug"
        },
        {
            "name": "linux-clang-relwithdebinfo",
            "configurePreset": "linux-clang-relwithdebinfo"
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release"
        },
        {
            "name": "linux-deploy-release",
            "configurePreset": "linux-deploy-release",
            "inherits": [
                "deploy-base"
            ]
        }
    ]
}